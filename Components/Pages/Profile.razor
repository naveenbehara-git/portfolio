@page "/profile"
@using System.ComponentModel.DataAnnotations;
@using MyPortfolio.Model;
@using MyPortfolio.Model.Common;

@inherits ProfileBase;

<div class="profile-container">
    <div class="profile-header">
        @if (!string.IsNullOrEmpty(@profileModel.ImagePath))
        {
            <img src="@profileModel.ImagePath" alt="Profile Photo" class="profile-photo" />
        }
        else
        {
            <img src="default_profile.png" alt="Profile Photo" class="profile-photo" />
        }
        <h1>@profileModel.FullName</h1>
        <p> ✉️ @profileModel.Email | 📞 @profileModel.PhoneNumber</p>
    </div>

    <div class="profile-info">
        <h2>Career Objective</h2>
        <div>
            <p>@profileModel.CareerGoal </p>
        </div>
    </div>

    <div class="profile-info">
        <h2>Personal Information</h2>
        <div class="info-grid">
            <div><strong>Gender:</strong> @profileModel.Gender</div>
            <div><strong>Current Address:</strong> @profileModel.CurrentAddress</div>
            <div><strong>City:</strong> @profileModel.City</div>
            <div><strong>State:</strong> @profileModel.State</div>
            <div><strong>Country:</strong> @profileModel.Country</div>
            <div><strong>Date of Birth:</strong> @profileModel.DateOfBirth</div>
            <div><strong>Marital Status:</strong> @profileModel.MaritalStatus</div>
            <div><strong>Languages:</strong> @profileModel.Languages</div>
            <div><strong>Permanent Address:</strong> @profileModel.PermanentAddress</div>
        </div>
    </div>

    <div class="profile-sections">
        <details open>
            <summary>🎓 Education</summary>
            <ul>
                @foreach (var edu in profileModel.Education)
                {
                    <li> @edu.Specification at @edu.InstitutionName - @edu.CGPA CGPA</li>
                }
            </ul>
        </details>

        <details>
            <summary>💼 Professional Experience</summary>
            <ul>
                @foreach (var exp in profileModel.Experience)
                {
                    <li>@exp.Role at @exp.EnterpriseName (@exp.StartDate - @exp.EndDate)</li>
                }
            </ul>
        </details>

        <details>
            <summary>🛠️ Skills</summary>
            <ul>
                @foreach (var skill in profileModel.Skills)
                {
                    <li>@skill.SkillName</li>
                }
            </ul>
        </details>

        <details>
            <summary>📜 Certifications</summary>
            <ul>
                @foreach (var cert in profileModel.Certifications)
                {
                    <li>@cert</li>
                }
            </ul>
        </details>
    </div>
</div>

<style>
    .profile-container {
        max-width: 1000px;
        margin: auto;
        padding: 40px;
        font-family: Arial, sans-serif;
        color: #333;
    }

    .profile-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .profile-photo {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        border: 4px solid #4a90e2;
        margin-bottom: 15px;
        object-fit: cover;
    }

    .profile-header h1 {
        margin: 10px 0 5px 0;
        font-size: 2rem;
        font-weight: bold;
    }

    .profile-header p {
        font-size: 1rem;
        color: #666;
    }

    .profile-info {
        margin-bottom: 30px;
    }

    .profile-info h2 {
        font-size: 1.5rem;
        margin-bottom: 15px;
        border-bottom: 2px solid #4a90e2;
        padding-bottom: 5px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        font-size: 1rem;
        background: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
    }

    .profile-sections details {
        background: #f1f1f1;
        margin-bottom: 15px;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .profile-sections summary {
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        margin-bottom: 10px;
    }

    .profile-sections ul {
        margin: 10px 0 0 20px;
        padding: 0;
    }

    .profile-sections li {
        margin-bottom: 8px;
    }
</style>

